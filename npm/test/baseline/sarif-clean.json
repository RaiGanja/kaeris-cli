{
 "json": {
  "code": 0,
  "stdout": {
   "ok": true,
   "missing": {},
   "extra": {},
   "placeholder_issues": [],
   "missing_files": [],
   "faults": [],
   "warnings": []
  },
  "stderr": ""
 },
 "human": {
  "code": 0,
  "stdout": "",
  "stderr": "→ SARIF report → r.sarif\n✓ de: complete & placeholder-safe\n✓ all locales complete & placeholder-safe\n"
 },
 "sarif": {
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
   {
    "tool": {
     "driver": {
      "name": "KAERIS",
      "informationUri": "https://kaeris.dev",
      "rules": [
       {
        "id": "missing-key",
        "name": "Key missing from a locale",
        "shortDescription": {
         "text": "Key missing from a locale"
        },
        "fullDescription": {
         "text": "A key present in the source file has no translation in this locale."
        },
        "helpUri": "https://kaeris.dev/developer.html"
       },
       {
        "id": "placeholder",
        "name": "Placeholder lost or altered",
        "shortDescription": {
         "text": "Placeholder lost or altered"
        },
        "fullDescription": {
         "text": "A placeholder ({name}, %s, %d, <b>…) present in the source is missing or changed type in the translation — this breaks formatting at runtime."
        },
        "helpUri": "https://kaeris.dev/developer.html"
       },
       {
        "id": "translation-fault",
        "name": "Translation fault",
        "shortDescription": {
         "text": "Translation fault"
        },
        "fullDescription": {
         "text": "A deterministic defect in the translation: dropped glossary term, plural form missing for the language's CLDR rules, number or currency drift, broken entity, ICU syntax."
        },
        "helpUri": "https://kaeris.dev/developer.html"
       },
       {
        "id": "translation-warning",
        "name": "Translation warning",
        "shortDescription": {
         "text": "Translation warning"
        },
        "fullDescription": {
         "text": "A soft signal worth a look: text left in the source language, register drift, cross-key inconsistency, or a translation long enough to overflow the UI."
        },
        "helpUri": "https://kaeris.dev/developer.html"
       },
       {
        "id": "extra-key",
        "name": "Key not in the source",
        "shortDescription": {
         "text": "Key not in the source"
        },
        "fullDescription": {
         "text": "A key exists in this locale but not in the source file — usually a leftover after a rename or deletion."
        },
        "helpUri": "https://kaeris.dev/developer.html"
       }
      ]
     }
    },
    "results": []
   }
  ]
 }
}
